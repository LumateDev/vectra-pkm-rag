{
  "Jwt": {
    "Key": "VectraPKM-Development-Only-Test-Key-Replace-Before-Production-2026!",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30,
    "TokenCleanupIntervalHours": 1,
    "Issuer": "VectraPKM.Api",
    "Audience": "VectraPKM.Client"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Auth": "Host=localhost;Port=5432;Database=vectra_pkm;Username=postgres;Password=postgres"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Formatting.Compact"
    ],
    "MinimumLevel": {
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      },
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  }
}

{
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Formatting.Compact"
    ],
    "MinimumLevel": {
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      },
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        },
        "Name": "Console"
      }
    ]
  }
}

# OpenAPI-документ запущенного API или путь к локальному файлу OpenAPI.
SWAGGER_URL=https://127.0.0.1:7000/swagger/v1/swagger.json

# HTTPS-адрес Kestrel для локального прокси Quasar.
API_PROXY_TARGET=https://127.0.0.1:7000

# Пустое значение использует текущий origin SPA и локальный прокси.
# Для внешнего API указывается origin, например https://api.example.com.
QCLI_API_BASE_URL=
